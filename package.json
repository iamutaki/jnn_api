{
  "name": "jnn-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:staging": "wrangler dev --env staging --remote",
    "dev:prod": "wrangler dev --env production --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply jnn-api-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply jnn_staging --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply jnn_production --env production --remote",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "JNN API — Cloudflare Workers + Hono",
  "dependencies": {
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260609.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.98.0"
  }
}
